+package org.libreoffice.androidapp;
+
+import android.content.Context;
+import android.graphics.Typeface;
+import android.net.Uri;
+import android.util.Log;
+
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.util.Locale;
+
+/** Imports user-authorized fonts into the private LibreOffice Fontconfig directory. */
+public final class HindiFontImport {
+    private static final String TAG = "FZHindiFonts";
+    private static final int MAX_FONT_BYTES = 24 * 1024 * 1024;
+
+    private HindiFontImport() { }
+
+    public static File getFontDirectory(Context context) {
+        return new File(context.getApplicationInfo().dataDir, "user/fonts");
+    }
+
+    public static int countImportedFonts(Context context) {
+        File[] files = getFontDirectory(context).listFiles();
+        if (files == null) return 0;
+        int count = 0;
+        for (File file : files) {
+            if (file.isFile() && isFontExtension(file.getName())) count++;
+        }
+        return count;
+    }
+
+    public static File importFont(Context context, Uri uri, String displayName) throws IOException {
+        if (uri == null) throw new IOException("No font file was selected.");
+        String extension = extension(displayName);
+        if (!".ttf".equals(extension) && !".otf".equals(extension)) {
+            throw new IOException("Only individual TTF and OTF files are supported.");
+        }
+
+        File directory = getFontDirectory(context);
+        if (!directory.exists() && !directory.mkdirs()) {
+            throw new IOException("Could not create the private font directory.");
+        }
+        String base = safeName(displayName, extension);
+        File destination = uniqueFile(directory, base, extension);
+        byte[] signature = new byte[4];
+        int signatureBytes = 0;
+        int total = 0;
+
+        try (InputStream input = context.getContentResolver().openInputStream(uri);
+             FileOutputStream output = new FileOutputStream(destination)) {
+            if (input == null) throw new IOException("Could not read the selected font.");
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = input.read(buffer)) != -1) {
+                total += read;
+                if (total > MAX_FONT_BYTES) {
+                    throw new IOException("Font file exceeds the 24 MB import limit.");
+                }
+                if (signatureBytes < signature.length) {
+                    int keep = Math.min(read, signature.length - signatureBytes);
+                    System.arraycopy(buffer, 0, signature, signatureBytes, keep);
+                    signatureBytes += keep;
+                }
+                output.write(buffer, 0, read);
+            }
+            output.flush();
+        } catch (Exception exception) {
+            destination.delete();
+            if (exception instanceof IOException) throw (IOException) exception;
+            throw new IOException("Could not copy this font file.", exception);
+        }
+
+        if (!isSupportedSignature(signature)) {
+            destination.delete();
+            throw new IOException("The selected file is not a supported TTF/OTF font.");
+        }
+        try {
+            Typeface.createFromFile(destination);
+        } catch (Exception exception) {
+            destination.delete();
+            throw new IOException("Android could not validate this font file.", exception);
+        }
+
+        clearFontconfigCache(context);
+        Log.i(TAG, "Imported font into user/fonts: " + destination.getName());
+        return destination;
+    }
+
+    private static void clearFontconfigCache(Context context) {
+        File cache = new File(context.getApplicationInfo().dataDir, "fontconfig");
+        File[] entries = cache.listFiles();
+        if (entries != null) {
+            for (File entry : entries) deleteRecursively(entry);
+        }
+    }
+
+    private static void deleteRecursively(File file) {
+        if (file.isDirectory()) {
+            File[] children = file.listFiles();
+            if (children != null) {
+                for (File child : children) deleteRecursively(child);
+            }
+        }
+        if (!file.delete()) Log.w(TAG, "Could not clear Fontconfig cache entry: " + file.getName());
+    }
+
+    private static File uniqueFile(File directory, String base, String extension) {
+        File result = new File(directory, base + extension);
+        int suffix = 2;
+        while (result.exists()) {
+            result = new File(directory, base + "-" + suffix + extension);
+            suffix++;
+        }
+        return result;
+    }
+
+    private static String safeName(String fileName, String extension) {
+        String value = fileName == null ? "Imported-Hindi-Font" : fileName;
+        if (value.toLowerCase(Locale.ROOT).endsWith(extension)) {
+            value = value.substring(0, value.length() - extension.length());
+        }
+        value = value.replaceAll("[^A-Za-z0-9._-]", "_");
+        if (value.length() > 70) value = value.substring(value.length() - 70);
+        return value.isEmpty() ? "Imported-Hindi-Font" : value;
+    }
+
+    private static String extension(String name) {
+        if (name == null) return "";
+        int dot = name.lastIndexOf('.');
+        return dot < 0 ? "" : name.substring(dot).toLowerCase(Locale.ROOT);
+    }
+
+    private static boolean isFontExtension(String name) {
+        String ext = extension(name);
+        return ".ttf".equals(ext) || ".otf".equals(ext);
+    }
+
+    private static boolean isSupportedSignature(byte[] bytes) {
+        if (bytes == null || bytes.length < 4) return false;
+        String tag = new String(bytes, java.nio.charset.StandardCharsets.US_ASCII);
+        return "OTTO".equals(tag) || "true".equals(tag) || "typ1".equals(tag)
+                || (bytes[0] == 0 && bytes[1] == 1 && bytes[2] == 0 && bytes[3] == 0);
+    }
+}
